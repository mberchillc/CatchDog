# Configurar como secretos de producción. Nunca colocar aquí los valores reales.
TURI_VAULT_KEY=
TURI_AUTH_PEPPER=
TURI_INVITATIONS=
# Ausente por defecto. No habilitar antes de validar permisos, conector y despliegue.
# TURI_ENABLE_PORTAL_SECRETS=1

# Correo transaccional. Remitente verificado; configurar como secretos del entorno.
RESEND_API_KEY=
TURI_MAIL_FROM=

# Opcional: enlaces de recuperación de código, emitidos fuera del sitio por su propietario.
# Guardar sólo id, userId, username, tenantId, tokenHash y expiresAt, nunca el token original.
TURI_CODE_RECOVERY_GRANTS=

# Opcional: permiso de un solo uso emitido por el propietario para la contraseña del superadministrador.
# Sólo metadatos de cuenta, tokenHash, expectedPasswordHash y expiresAt; nunca el token original.
TURI_ADMIN_PASSWORD_RESET_GRANTS=

# Invitaciones adicionales de productores. Se conservan las invitaciones originales.
# Cada entrada debe tener role=producer, id, username, name, tenantId, tokenHash y expiresAt.
TURI_PAS_INVITATIONS=
